# Copy to .env and fill in. Never commit .env.

# Riot personal API key (https://developer.riotgames.com).
RIOT_API_KEY=

# Platform routing value of the tracked account. The regional host used by account-v1 and
# match-v5 is derived from it (euw1/eun1/tr1/ru -> europe, na1/br1/la1/la2 -> americas, kr/jp1 -> asia, ...).
RIOT_PLATFORM=euw1

# Where the SQLite database lives (also used by compose.yaml).
ORACLE_DATA_DIR=./data

# Linux only: your `id -u` / `id -g`, so docker-created files are owned by you.
# HOST_UID=1000
# HOST_GID=1000

# Discord bot (only `oracle bot` and `oracle prophesy --send` need these). See docs/wiki/Discord-Bot.md.
# Bot token from the Bot page of your application in the Discord developer portal. Keep it secret.
DISCORD_BOT_TOKEN=
# Numeric id of the channel the bot posts in (Developer Mode, right-click the channel, Copy Channel ID).
DISCORD_CHANNEL_ID=
# Folder with model.joblib and model_card.json, relative to this file. Change it to switch models.
ORACLE_MODEL_DIR=./training/artifacts/win_lr

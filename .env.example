# Copy to .env and fill in. Never commit .env.

# Riot personal API key (https://developer.riotgames.com).
RIOT_API_KEY=

# Platform routing value of the tracked account. The regional host used by account-v1 and
# match-v5 is derived from it (euw1/eun1/tr1/ru -> europe, na1/br1/la1/la2 -> americas, kr/jp1 -> asia, ...).
RIOT_PLATFORM=euw1

# Where the SQLite database lives (also used by compose.yaml).
ORACLE_DATA_DIR=./data

# Linux only: your `id -u` / `id -g`, so docker-created files are owned by you.
# HOST_UID=1000
# HOST_GID=1000
